# Copy this file to .env.local and fill in the values.
# Never commit .env.local.

# Supabase → Project Settings → API (or "Connect")
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret "service_role" key (server-only; never put it in client code)
SUPABASE_SERVICE_ROLE_KEY=

# Password for /en/admin and /ar/admin
ADMIN_PASSWORD=

# Optional: email each new or changed RSVP (https://resend.com → API Keys).
# Without a domain of your own, Resend only delivers to the address you
# signed up with, so use that address here. Comma-separate several.
RESEND_API_KEY=
RSVP_NOTIFY_EMAIL=
